# Example local-development configuration for the HavenBridge API.
#
# Copy this file to .env only on your local development machine:
#
#   cp .env.example .env
#
# Never commit the real .env file because it may contain database credentials.

# General application settings.
APP_NAME="HavenBridge API"
APP_ENVIRONMENT="development"
APP_HOST="0.0.0.0"
APP_PORT=8000
LOG_LEVEL="INFO"

# Local PostgreSQL connection settings.
#
# When the API runs in Kubernetes, POSTGRES_HOST will point to the
# havenbridge-postgres Kubernetes Service instead of 127.0.0.1.
POSTGRES_HOST="127.0.0.1"
POSTGRES_PORT=5432
POSTGRES_DB="havenbridge"
POSTGRES_USER="havenbridge_admin"

# Local development may supply the password directly.
# Replace this placeholder only inside your untracked .env file.
POSTGRES_PASSWORD="replace-with-local-development-password"

# Leave this unset during local development.
# Kubernetes will use:
#
# POSTGRES_PASSWORD_FILE="/run/secrets/postgres-password"
#
# POSTGRES_PASSWORD_FILE=

# SQLAlchemy connection-pool settings.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_CONNECT_TIMEOUT_SECONDS=5
# Allow SQLAlchemy to create missing tables during local development.
# Alembic migrations will replace this later.
DB_AUTO_CREATE_TABLES=true
