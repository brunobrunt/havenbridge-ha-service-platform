# Local Python environment.
.venv/
venv/

# Environment files may contain secrets.
.env
.env.*

# Keep the safe example file available in Git.
!.env.example

# Python-generated files.
__pycache__/
*.pyc
*.pyo

# Testing files are not required in the runtime image.
.pytest_cache/
tests/
pytest.ini
requirements-dev.txt

# IDE and Git metadata.
.idea/
.vscode/
.git/
.gitignore

# Local documentation and logs.
README.md
*.log
