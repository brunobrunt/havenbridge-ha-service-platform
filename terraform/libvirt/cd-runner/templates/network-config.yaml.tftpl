version: 2

ethernets:
  primary:
    match:
      macaddress: "${mac_address}"

    set-name: eth0

    dhcp4: false
    dhcp6: false

    addresses:
      - "${ip_address}/${network_prefix}"

    routes:
      - to: default
        via: "${gateway}"

    nameservers:
      addresses:
%{ for dns_server in dns_servers ~}
        - "${dns_server}"
%{ endfor ~}
      search:
        - "${domain_name}"
